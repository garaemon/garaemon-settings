{{- /* chezmoi:modify-template */ -}}
{{- /*
  chezmoi passes the current ~/.claude/settings.json in .chezmoi.stdin and
  installs what this template renders. Claude Code writes permissions and
  plugin state into that file, so merging keeps those edits where a plain
  dot_claude/settings.json would overwrite them on every apply.
  The merge uses chezmoi's own template functions instead of jq, because
  bootstrap.sh applies the dotfiles before mise installs jq.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $settings = setValueAtPath (list "enabledPlugins" "i-have-adhd@i-have-adhd") true $settings -}}
{{- $settings = setValueAtPath (list "extraKnownMarketplaces" "i-have-adhd") (dict "source" (dict "source" "github" "repo" "ayghri/i-have-adhd")) $settings -}}
{{- /*
  Register the worklog hook once, after any SessionEnd hooks the user added.
  Replacing the list would drop hooks that Claude Code's /hooks wrote there.
*/ -}}
{{- $worklogCommand := "$HOME/.claude/hooks/claude_worklog.py" -}}
{{- $sessionEndGroups := dig "hooks" "SessionEnd" (list) $settings -}}
{{- if not (contains (toJson $worklogCommand) (toJson $sessionEndGroups)) -}}
{{-   $worklogGroup := dict "hooks" (list (dict "type" "command" "command" $worklogCommand)) -}}
{{-   $settings = setValueAtPath (list "hooks" "SessionEnd") (append $sessionEndGroups $worklogGroup) $settings -}}
{{- end -}}
{{- toPrettyJson "  " $settings -}}
