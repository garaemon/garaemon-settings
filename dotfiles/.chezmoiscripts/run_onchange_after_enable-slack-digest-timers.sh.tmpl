#!/bin/bash
set -euo pipefail

# chezmoi reruns this script only when its rendered text changes, so embed a
# hash of every unit under dot_config/systemd/user. Editing a unit then
# reloads systemd and re-enables the timers on the next `chezmoi apply`.
# artist-live-digest-slack.service: {{ include "dot_config/systemd/user/artist-live-digest-slack.service" | sha256sum }}
# artist-live-digest-slack.timer: {{ include "dot_config/systemd/user/artist-live-digest-slack.timer" | sha256sum }}
# news-digest-slack.service: {{ include "dot_config/systemd/user/news-digest-slack.service" | sha256sum }}
# news-digest-slack.timer: {{ include "dot_config/systemd/user/news-digest-slack.timer" | sha256sum }}
# spotify-daily-digest-slack.service: {{ include "dot_config/systemd/user/spotify-daily-digest-slack.service" | sha256sum }}
# spotify-daily-digest-slack.timer: {{ include "dot_config/systemd/user/spotify-daily-digest-slack.timer" | sha256sum }}

# chezmoi can apply over an ssh session that reaches no systemd user manager,
# for example before lingering is enabled. Leave the timers for the next apply.
if ! command -v systemctl >/dev/null 2>&1 \
  || ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "skip: no systemd --user session, leaving the Slack digest timers alone"
  exit 0
fi

# A chezmoi apply aimed outside the login home writes units where systemd's
# user manager never looks. dotfiles/tests/test_install_sh.py does exactly that,
# and a failed `enable` would abort install.sh.
readonly login_home="$(getent passwd "$(id -u)" | cut -d: -f6)"
if [ "{{ .chezmoi.destDir }}" != "${login_home}" ]; then
  echo "skip: applying to {{ .chezmoi.destDir }}, not the login home ${login_home}"
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now \
  artist-live-digest-slack.timer \
  news-digest-slack.timer \
  spotify-daily-digest-slack.timer
