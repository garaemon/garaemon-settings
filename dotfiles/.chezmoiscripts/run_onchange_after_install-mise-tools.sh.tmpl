#!/bin/bash
set -euo pipefail

# chezmoi reruns this script only when its rendered text changes, so embed a
# hash of the mise config. Adding a tool or bumping a pin, chezmoi included,
# then installs it on the next `chezmoi apply`.
# dot_config/mise/config.toml: {{ include "dot_config/mise/config.toml" | sha256sum }}

# Prints the home directory from the account database rather than ${HOME},
# which the install tests point at a scratch directory. macOS has no getent.
print_login_home() {
  if command -v getent >/dev/null 2>&1; then
    getent passwd "$(id -u)" | cut -d: -f6
  else
    dscl . -read "/Users/$(id -un)" NFSHomeDirectory | sed 's/^NFSHomeDirectory: //'
  fi
}

if ! command -v mise >/dev/null 2>&1; then
  echo "skip: mise is not installed, leaving the tools in dot_config/mise alone"
  exit 0
fi

# dotfiles/tests/test_install_sh.py applies into a scratch home. Installing
# from that copy would download every tool into the user's real mise data dir.
login_home="$(print_login_home)"
readonly login_home
if [ "{{ .chezmoi.destDir }}" != "${login_home}" ]; then
  echo "skip: applying to {{ .chezmoi.destDir }}, not the login home ${login_home}"
  exit 0
fi

# A failed download exits non-zero, so chezmoi does not record this script as
# run and retries the install on the next apply.
mise install --yes
