[core]
	pager = delta
	excludesFile = ~/.gitignore
[alias]
	see = browse
	p = pull-request
	br = branch
	co = checkout
	cop = checkout-pr
	st = status
	unstage = reset -q HEAD --
	uncommit = reset --mixed HEAD~
	graph = log --graph -10 --branches --remotes --tags --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
	precommit = diff --cached --diff-algorithm=minimal -w
	unmerged = diff --name-only --diff-filter=U
	remotes = remote -v
	new-branch = "!f() { git checkout -b \"$(date +%Y.%m.%d)-$1\"; }; f"
[rebase]
	autostash = true
[github]
	user = garaemon
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[user]
	name = Ryohei Ueda
    {{ if eq .chezmoi.username "rueda" }}
	email = r.ueda@gitai.tech
    {{ else }}
    email = garaemon@gmail.com
    {{ end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = True
	side-by-side = True
[merge]
	{{- /* zdiff3 needs git 2.35+. Older git rejects it, so fall back to diff3. */}}
	{{- $gitVersion := "0.0.0" }}
	{{- if lookPath "git" }}
	{{- $gitVersion = output "git" "--version" | regexFind "[0-9]+\\.[0-9]+(\\.[0-9]+)?" }}
	{{- end }}
	{{- if semverCompare ">=2.35.0" $gitVersion }}
	conflictStyle = zdiff3
	{{- else }}
	conflictStyle = diff3
	{{- end }}
[init]
	defaultBranch = main
[push]
	default = current
	autoSetupRemote = true
